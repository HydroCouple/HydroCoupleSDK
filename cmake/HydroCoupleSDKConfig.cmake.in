@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

set(HYDROCOUPLESDK_FOUND 1)
set_and_check(HYDROCOUPLESDK_INCLUDE_DIR  "@PACKAGE_INCLUDE_INSTALL_DIR@")
set_and_check(HYDROCOUPLESDK_INCLUDE_DIRS ${HYDROCOUPLESDK_INCLUDE_DIR})
set_and_check(HYDROCOUPLESDK_LIBRARY_DIR  "@PACKAGE_LIB_INSTALL_DIR@")
set_and_check(HYDROCOUPLESDK_LIBRARIES    "@PACKAGE_LIB_INSTALL_DIR@")
check_required_components("@PROJECT_NAME@")
