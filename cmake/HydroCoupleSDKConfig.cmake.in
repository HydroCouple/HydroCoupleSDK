@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Usage requirements of an SDK built with optional backends. The variables
# below record how this SDK was configured so consumers can branch on them.
set(HYDROCOUPLESDK_WITH_MPI        @USE_MPI@)
set(HYDROCOUPLESDK_WITH_KOKKOS     @USE_KOKKOS@)
set(HYDROCOUPLESDK_WITH_GDAL       @USE_GDAL@)
set(HYDROCOUPLESDK_WITH_HDF5       @USE_HDF5@)
set(HYDROCOUPLESDK_WITH_GEOPACKAGE @USE_GEOPACKAGE@)
set(HYDROCOUPLESDK_WITH_NETCDF     @USE_NETCDF@)
set(HYDROCOUPLESDK_WITH_TOOLS      @BUILD_TOOLS@)
set(HYDROCOUPLESDK_WITH_INTERFACE_PACKAGE @HYDROCOUPLESDK_HAVE_INTERFACE_PACKAGE@)

# The SDK's public headers include hydrocouple.h. When this SDK was built
# against the interface project's installed package, that package supplies
# the headers; otherwise they were installed alongside the SDK's own.
if(HYDROCOUPLESDK_WITH_INTERFACE_PACKAGE)
    find_dependency(HydroCouple)
endif()

# Optional IO backends. They are PRIVATE link dependencies, but CMake still
# records them in the exported link interface (as $<LINK_ONLY:...>), so the
# targets must exist for a consumer to link. Each is resolved through the
# same fallback chain the SDK itself used.
if(HYDROCOUPLESDK_WITH_HDF5 AND NOT TARGET hdf5::hdf5-shared
                            AND NOT TARGET hdf5::hdf5-static
                            AND NOT TARGET HDF5::HDF5)
    find_dependency(hdf5 CONFIG NAMES hdf5 HDF5)
    if(NOT TARGET hdf5::hdf5-shared AND NOT TARGET hdf5::hdf5-static
       AND NOT TARGET HDF5::HDF5)
        find_dependency(HDF5 COMPONENTS C)
    endif()
    find_dependency(ZLIB)
endif()

if(HYDROCOUPLESDK_WITH_NETCDF AND NOT TARGET netCDF::netcdf)
    find_dependency(netCDF CONFIG)
endif()

if(HYDROCOUPLESDK_WITH_GEOPACKAGE AND NOT TARGET unofficial::sqlite3::sqlite3
                                  AND NOT TARGET SQLite::SQLite3)
    find_package(unofficial-sqlite3 CONFIG QUIET)
    if(NOT TARGET unofficial::sqlite3::sqlite3)
        find_dependency(SQLite3)
    endif()
endif()

# yaml-cpp is optional and PRIVATE, but likewise appears in the exported
# link interface when the SDK was built with it.
set(HYDROCOUPLESDK_WITH_YAML_CPP @HYDROCOUPLESDK_HAVE_YAML_CPP@)
if(HYDROCOUPLESDK_WITH_YAML_CPP AND NOT TARGET yaml-cpp::yaml-cpp
                                AND NOT TARGET yaml-cpp)
    find_dependency(yaml-cpp CONFIG)
endif()

if(HYDROCOUPLESDK_WITH_KOKKOS AND NOT TARGET Kokkos::kokkos)
    find_dependency(Kokkos CONFIG)
endif()

# nlohmann/json.hpp is included by the SDK's public data-item headers. It is
# resolved through its own package when this SDK was built against one;
# otherwise the single header was installed alongside the SDK's headers.
set(HYDROCOUPLESDK_WITH_NLOHMANN_PACKAGE @nlohmann_json_FOUND@)
if(HYDROCOUPLESDK_WITH_NLOHMANN_PACKAGE)
    find_dependency(nlohmann_json)
endif()

# MPI is a PUBLIC usage requirement: the installed abstractmodelcomponent.h
# includes <mpi.h> when the SDK was built with USE_MPI.
if(HYDROCOUPLESDK_WITH_MPI)
    find_dependency(MPI)
endif()
if(HYDROCOUPLESDK_WITH_GDAL)
    find_dependency(GDAL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

set(HYDROCOUPLESDK_FOUND 1)
set_and_check(HYDROCOUPLESDK_INCLUDE_DIR  "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set(HYDROCOUPLESDK_INCLUDE_DIRS "${HYDROCOUPLESDK_INCLUDE_DIR}")
set_and_check(HYDROCOUPLESDK_LIBRARY_DIR  "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set(HYDROCOUPLESDK_LIBRARIES HydroCoupleSDK::HydroCoupleSDK)
if(HYDROCOUPLESDK_WITH_TOOLS AND TARGET HydroCoupleSDK::HydroCoupleTools)
    list(APPEND HYDROCOUPLESDK_LIBRARIES HydroCoupleSDK::HydroCoupleTools)
endif()

check_required_components("@PROJECT_NAME@")
