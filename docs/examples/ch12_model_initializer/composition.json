{
  "schema_version": "1.1",
  "metadata": { "caption": "Chapter 12 initializer example" },
  "components": [
    {
      "id": "profile",
      "arguments": { "scale": { "values": [10.0, 20.0, 30.0] } }
    },
    {
      "id": "upstream",
      "arguments": { "scale": { "@uri": "scale.json" } }
    },
    {
      "id": "channel",
      "arguments": {
        "initial": { "@from": { "component": "profile", "output": "series" } },
        "weights": { "@uri": "memory:weights" }
      }
    }
  ],
  "connections": [
    {
      "from": {
        "component": "upstream",
        "output": "series",
        "adapted_outputs": [
          {
            "factory": "hydrocouple.sdk.adapters",
            "id": "linear_transform",
            "arguments": { "multiplier": { "values": [0.5] } }
          }
        ]
      },
      "to": { "component": "channel", "input": "inflow" }
    }
  ],
  "workflow": { "strategy": "time_stepped" },
  "writers": [ { "type": "csv", "path": "out/results.csv" } ],
  "run": { "manifest": "out/run.json" }
}
